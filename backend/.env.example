# Puerto de ejecución del servidor Express
PORT=5000

# Cadena de conexión a MongoDB (Local o MongoDB Atlas)
# Ejemplo local:
MONGO_URI=mongodb://127.0.0.1:27017/enjoy_psicopedagogia
# Ejemplo Atlas:
# MONGO_URI=mongodb+srv://<usuario>:<password>@cluster0.mongodb.net/enjoy_psicopedagogia?retryWrites=true&w=majority

# Clave secreta para la firma y verificación de tokens JWT
JWT_SECRET=REEMPLAZAR_POR_UNA_CLAVE_SEGURA

# Tiempo de expiración del token JWT (ej. 24h, 7d)
JWT_EXPIRES_IN=24h

# Entorno de ejecución
NODE_ENV=development

